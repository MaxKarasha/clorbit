{
  "name": "clorbit",
  "private": true,
  "version": "0.4.1",
  "description": "Your Claude Code agents, in orbit — a local, read-only dashboard over Claude Code sessions.",
  "license": "MIT",
  "author": "Maksym Karasha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxKarasha/clorbit.git"
  },
  "homepage": "https://github.com/MaxKarasha/clorbit#readme",
  "bugs": {
    "url": "https://github.com/MaxKarasha/clorbit/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "dashboard",
    "agents",
    "observability",
    "tokens"
  ],
  "type": "module",
  "bin": {
    "clorbit": "plugin/app/cli.mjs"
  },
  "files": [
    "plugin/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node plugin/app/server.mjs",
    "clorbit": "node plugin/app/cli.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "0.28.2",
    "gifenc": "1.0.3",
    "mp4-muxer": "5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "webm-muxer": "5.1.4"
  }
}
